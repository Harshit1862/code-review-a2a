# ---------- LLM ----------
# "groq" for real runs, "fake" to test the plumbing offline (no API key, no cost)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
# Use the model you used in Food Agents; it must support tool calling
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=code_review

# ---------- GitHub ----------
# Fine-grained token: only your tracked repos, permission Contents -> Read-only
GITHUB_TOKEN=github_pat_xxx
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Paste the same value into the GitHub webhook "Secret" field
GITHUB_WEBHOOK_SECRET=change_me

# ---------- App ----------
APP_TIMEZONE=Asia/Kolkata
# Enables POST /dev/ingest-local (store a push from a local git repo). Keep false in production.
DEV_ENDPOINTS=true

# ---------- Reviewer agents (A2A) ----------
REVIEWER_HOST=127.0.0.1
CODE_REVIEWER_URL=http://127.0.0.1:10001
BEST_PRACTICE_REVIEWER_URL=http://127.0.0.1:10002
SECURITY_REVIEWER_URL=http://127.0.0.1:10003

# ---------- Limits ----------
MAX_FILES_PER_PUSH=50
MAX_FILE_BYTES=200000
# Max characters of code sent to the LLM per review (keeps you under Groq rate limits)
LLM_MAX_CHARS=24000
REVIEWER_TIMEOUT_SECONDS=240
